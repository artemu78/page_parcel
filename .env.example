# Readable Web - Environment Configuration Example

NODE_ENV=production
PORT=8080

# VK Community Configuration
VK_GROUP_ID=123456789
VK_GROUP_TOKEN=vk1.a.EXAMPLE_COMMUNITY_TOKEN_DO_NOT_COMMIT
VK_SECRET=my_callback_api_secret
VK_CONFIRMATION_CODE=abc12345

# Yandex Message Queue (SQS-compatible)
YMQ_QUEUE_URL=https://message-queue.api.cloud.yandex.net/b1g.../dj6.../readable-web-jobs
YMQ_DLQ_URL=https://message-queue.api.cloud.yandex.net/b1g.../dj6.../readable-web-dlq
AWS_REGION=ru-central1
AWS_ACCESS_KEY_ID=YCAJE_EXAMPLE_KEY_ID
AWS_SECRET_ACCESS_KEY=YCAJE_EXAMPLE_SECRET_ACCESS_KEY

# YDB (Yandex Database)
YDB_ENDPOINT=grpcs://ydb.serverless.yandexcloud.net:2135/?database=/ru-central1/b1g.../etn...
YDB_DATABASE=/ru-central1/b1g.../etn...

# Network and Proxy
EGRESS_PROXY_PORT=8050

# Worker Service Configuration
WORKER_PORT=8081
TRIGGER_SECRET=optional_internal_trigger_auth_token

# Observability
LOG_LEVEL=info
