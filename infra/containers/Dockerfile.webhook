# syntax=docker/dockerfile:1
FROM node:22-bookworm-slim AS manifests

WORKDIR /app
COPY package*.json ./
COPY apps/webhook/package.json ./apps/webhook/
COPY apps/worker/package.json ./apps/worker/
COPY packages/jobs/package.json ./packages/jobs/
COPY packages/observability/package.json ./packages/observability/
COPY packages/pdf/package.json ./packages/pdf/
COPY packages/rendering/package.json ./packages/rendering/
COPY packages/safe-network/package.json ./packages/safe-network/
COPY packages/vk/package.json ./packages/vk/

FROM manifests AS builder
RUN --mount=type=cache,target=/root/.npm npm ci --ignore-scripts

COPY tsconfig.json ./
COPY packages/ ./packages/
COPY apps/ ./apps/
RUN npm run build

# Production runtime
FROM node:22-bookworm-slim AS runner

WORKDIR /app
ENV NODE_ENV=production
ENV PORT=8080

RUN rm -f /etc/apt/apt.conf.d/docker-clean
RUN --mount=type=cache,target=/var/cache/apt,sharing=locked \
    --mount=type=cache,target=/var/lib/apt,sharing=locked \
    apt-get update && apt-get install -y --no-install-recommends \
    ca-certificates

COPY --from=manifests /app/ ./

# Install production dependencies before copying application code.
RUN --mount=type=cache,target=/root/.npm npm ci --omit=dev --ignore-scripts

COPY --from=builder /app/packages/ ./packages/
COPY --from=builder /app/apps/ ./apps/

USER node

EXPOSE 8080

HEALTHCHECK --interval=30s --timeout=3s --start-period=5s --retries=3 \
  CMD node -e "fetch('http://localhost:8080/healthz').then(r => r.ok ? process.exit(0) : process.exit(1))"

CMD ["node", "apps/webhook/dist/index.js"]
